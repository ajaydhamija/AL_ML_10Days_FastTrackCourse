\newcommand{\bars}[4]{\begin{tikzpicture}
  \draw[ISSAdark!60,line width=0.6pt](0,0)--(0,#2);
 \foreach \l/\v/\c [count=\i from 0] in {#4}{%
  \foreach \gv in {0.25,0.5,0.75,1}{\draw[ISSAlgrey!80!black,line width=0.3pt]({\i*#3},{\gv*#2})--({(\i+1)*#3},{\gv*#2});}
  \fill[\c!75!black!10!\c] ({\i*#3+0.12},0) rectangle ({(\i+1)*#3-0.12},{\v/#1*#2});
  \node[font=\scriptsize\bfseries,anchor=south] at ({\i*#3+#3/2},{\v/#1*#2}){\v};
  \node[font=\fontsize{5.6}{6.6}\selectfont,anchor=north,text width=\dimexpr#3cm-3pt\relax,align=center] at ({\i*#3+#3/2},-0.04){\l};}
 \end{tikzpicture}}
